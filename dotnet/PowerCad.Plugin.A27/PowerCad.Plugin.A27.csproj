<Project Sdk="Microsoft.NET.Sdk">
  <!-- In-process AutoCAD 2027 add-in. AutoCAD 2027's managed API targets .NET 10 (AutoCAD.NET 26.0.0). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PowerCad.Plugin</RootNamespace>
    <AssemblyName>PowerCad.Plugin.A27</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reference assemblies only; AutoCAD supplies the real ones at runtime. -->
    <PackageReference Include="AutoCAD.NET" Version="26.0.0" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PowerCad.Core\PowerCad.Core.csproj" />
  </ItemGroup>
</Project>
